@{
    ViewData["Title"] = "About";
}

<section class="page-head">
    <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span>About</nav>
        <h1>Our story</h1>
        <p>Five decades of horological passion, expertise and trust.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <div class="about-visual" aria-hidden="true">
                    <i class="fas fa-store"></i>
                    <div class="about-badge"><strong>1968</strong>Founded in<br />Geneva, Switzerland</div>
                </div>
            </div>
            <div class="col-lg-7">
                <h2 class="mb-3">Born from a lifelong love of the mechanical</h2>
                <p class="text-muted-c">CHRONOS was founded in 1968 by master watchmaker Henri Marchand, who believed that truly exceptional timepieces deserved a home worthy of their craftsmanship. What began as a small atelier on Geneva's Rue du Rhône has grown into a trusted destination for connoisseurs of fine watchmaking.</p>
                <p class="text-muted-c">Today, led by the third generation of the Marchand family, we continue Henri's mission: to connect extraordinary watches with the people who will truly appreciate them.</p>
                <ol class="timeline">
                    <li><strong>1968</strong><span>Henri Marchand opens the first CHRONOS boutique in Geneva, Switzerland.</span></li>
                    <li><strong>1984</strong><span>Expansion to Paris, London and New York. CHRONOS becomes a global name.</span></li>
                    <li><strong>2001</strong><span>Launch of our proprietary authentication protocol, adopted by industry peers.</span></li>
                    <li><strong>2019</strong><span>Recognised as the most trusted luxury watch retailer by Watch Journal.</span></li>
                </ol>
            </div>
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="section-head"><h2>Mission &amp; vision</h2></div>
        <div class="row g-3 g-lg-4">
            <div class="col-md-4"><div class="mission-card"><div class="feature-icon"><i class="fas fa-bullseye"></i></div><h3>Our mission</h3><p>To connect discerning collectors with watches of enduring significance, delivered with integrity and expertise.</p></div></div>
            <div class="col-md-4"><div class="mission-card"><div class="feature-icon"><i class="fas fa-eye"></i></div><h3>Our vision</h3><p>To be the most respected steward of horological heritage, preserving fine watchmaking for future generations.</p></div></div>
            <div class="col-md-4"><div class="mission-card"><div class="feature-icon"><i class="fas fa-heart"></i></div><h3>Our values</h3><p>Authenticity in every transaction. Excellence without compromise. Relationships built on trust that last a lifetime.</p></div></div>
        </div>
    </div>
</section>

<section class="stat-strip">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3"><strong>57+</strong><span>Years of heritage</span></div>
            <div class="col-6 col-md-3"><strong>18,000+</strong><span>Watches sold</span></div>
            <div class="col-6 col-md-3"><strong>94%</strong><span>Client satisfaction</span></div>
            <div class="col-6 col-md-3"><strong>40+</strong><span>Brand partners</span></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head"><h2>The people behind CHRONOS</h2></div>
        <div class="row g-3 g-lg-4">
            <div class="col-sm-6 col-lg-3"><div class="team-card"><span class="avatar"><i class="fas fa-user-tie"></i></span><h3>Philippe Marchand</h3><span class="team-role">Chief Executive</span><p>Third-generation watchmaker. WOSTEP certified. 28 years in the industry.</p></div></div>
            <div class="col-sm-6 col-lg-3"><div class="team-card"><span class="avatar"><i class="fas fa-user"></i></span><h3>Elena Voss</h3><span class="team-role">Head of Authentication</span><p>Former Sotheby's specialist. Expert in Patek Philippe and Rolex authentication.</p></div></div>
            <div class="col-sm-6 col-lg-3"><div class="team-card"><span class="avatar"><i class="fas fa-user-graduate"></i></span><h3>James Okafor</h3><span class="team-role">Senior Horologist</span><p>Certified by the British Horological Institute. Restoration specialist.</p></div></div>
            <div class="col-sm-6 col-lg-3"><div class="team-card"><span class="avatar"><i class="fas fa-user-check"></i></span><h3>Aiko Tanaka</h3><span class="team-role">Client Relations Director</span><p>Fluent in five languages. Former boutique director for AP and JLC.</p></div></div>
        </div>
    </div>
</section>
