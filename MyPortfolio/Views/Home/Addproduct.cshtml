@model ViewmodelProduct
@{
    ViewData["Title"] = "Add product";
    Layout = "_AdminLayout";
}

<div class="admin-head">
    <div>
        <h1 class="admin-title">Add new product</h1>
        <p class="admin-sub">Fill in the details to list a new timepiece</p>
    </div>
</div>

<form asp-action="AddProduct" method="post" enctype="multipart/form-data" novalidate>
    <partial name="_ProductForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
