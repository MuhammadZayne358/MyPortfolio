@model AdminContactViewModel
@{
    ViewData["Title"] = "Contact messages";
    Layout = "_AdminLayout";
    var selected = Model.Selected;
}

<div class="admin-head">
    <div>
        <h1 class="admin-title">Contact messages</h1>
        <p class="admin-sub">
            @if (Model.UnreadCount > 0) { <strong>@Model.UnreadCount unread</strong> <span>message@(Model.UnreadCount == 1 ? "" : "s") awaiting your response</span> }
            else { <span>You're all caught up</span> }
        </p>
    </div>
    <div class="admin-actions">
        <form asp-action="MarkAllContactsRead" method="post"><button type="submit" class="btn-quiet btn-sm-c" @(Model.UnreadCount == 0 ? "disabled" : null)><i class="fas fa-check-double"></i> Mark all read</button></form>
        <form asp-action="DeleteReadContacts" method="post" data-confirm="Delete all messages that are marked as read?"><button type="submit" class="btn-danger-c btn-sm-c"><i class="fas fa-trash-can"></i> Delete read</button></form>
    </div>
</div>

@if (!Model.Messages.Any())
{
    <div class="admin-panel empty-state">
        <i class="fas fa-envelope-open"></i>
        <h3>No messages yet</h3>
        <p>Messages sent from the Contact page will appear here.</p>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-5 @(selected != null ? "d-none d-lg-block" : "")">
            <div class="msg-list">
                @foreach (var m in Model.Messages)
                {
                    <a class="msg-item @(m.IsRead ? "" : "is-unread") @(selected?.Id == m.Id ? "is-active" : "")" asp-action="AdminContact" asp-route-id="@m.Id">
                        <div class="msg-top"><span class="msg-name">@m.Name</span><span class="msg-time">@m.CreatedAt.ToString("dd MMM, HH:mm")</span></div>
                        <div class="msg-subject">@m.Subject</div>
                        <div class="msg-preview">@m.Message</div>
                    </a>
                }
            </div>
        </div>

        <div class="col-lg-7">
            @if (selected == null)
            {
                <div class="admin-panel empty-state d-none d-lg-block">
                    <i class="fas fa-envelope-open"></i>
                    <h3>Select a message</h3>
                    <p>Choose a message from the list to read it.</p>
                </div>
            }
            else
            {
                <div class="admin-panel">
                    <a class="btn-quiet btn-sm-c d-lg-none mb-3" asp-action="AdminContact"><i class="fas fa-arrow-left"></i> All messages</a>
                    <h2 class="h4 mb-1">@selected.Subject</h2>
                    <div class="text-muted-c" style="font-size:.85rem">@selected.CreatedAt.ToString("dddd, d MMMM yyyy 'at' HH:mm")</div>

                    <div class="d-flex align-items-center gap-3 mt-3">
                        <span class="avatar">@(selected.Name.Length > 0 ? selected.Name.Substring(0, 1).ToUpperInvariant() : "?")</span>
                        <div style="min-width:0">
                            <strong>@selected.Name</strong>
                            <div><a href="mailto:@selected.Email" style="word-break:break-all">@selected.Email</a></div>
                        </div>
                    </div>

                    <div class="msg-body">@selected.Message</div>

                    <div class="admin-actions">
                        <a class="btn-brand btn-sm-c" href="mailto:@selected.Email?subject=@Uri.EscapeDataString("Re: " + selected.Subject)"><i class="fas fa-reply"></i> Reply by email</a>
                        <form asp-action="ToggleContactRead" asp-route-id="@selected.Id" method="post"><button type="submit" class="btn-quiet btn-sm-c"><i class="fas fa-envelope"></i> Mark as unread</button></form>
                        <form asp-action="DeleteContact" asp-route-id="@selected.Id" method="post" data-confirm="Delete this message?"><button type="submit" class="btn-danger-c btn-sm-c"><i class="fas fa-trash-can"></i> Delete</button></form>
                    </div>
                </div>
            }
        </div>
    </div>
}
