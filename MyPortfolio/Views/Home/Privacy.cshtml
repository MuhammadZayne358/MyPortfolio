@{
    ViewData["Title"] = "Privacy policy";
}

<section class="page-head">
    <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb"><a asp-controller="Home" asp-action="Index">Home</a><span>/</span>Privacy policy</nav>
        <h1>Privacy policy</h1>
    </div>
</section>

<section class="section">
    <div class="container" style="max-width:760px">
        <p class="text-muted-c">This page explains what information CHRONOS collects and how it is used.</p>
        <h2 class="h4 mt-4">What we collect</h2>
        <p class="text-muted-c">When you create an account or place an order we store your name, email address and delivery details. Messages you send through the contact form are stored so our advisors can reply to you.</p>
        <h2 class="h4 mt-4">How we use it</h2>
        <p class="text-muted-c">Your information is used only to process orders, answer your enquiries and keep your account secure. We do not sell your personal data.</p>
        <h2 class="h4 mt-4">Questions</h2>
        <p class="text-muted-c">If you have any questions about this policy, please <a asp-controller="Home" asp-action="Contact">contact us</a>.</p>
    </div>
</section>
