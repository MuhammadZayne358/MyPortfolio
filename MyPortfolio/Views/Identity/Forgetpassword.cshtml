@{
    ViewData["Title"] = "Forgot password";
    var sent = ViewData["EmailSent"] is true;
}

<div class="auth-wrap">
    <div class="container">
        <div class="auth-card">
            <h1>Forgot password</h1>
            <p class="auth-sub">Enter your email and we'll send you a reset link.</p>

            @if (sent)
            {
                <div class="alert-c is-success" role="status"><i class="fas fa-circle-check mt-1"></i><span>If an account exists for that email, a reset link is on its way. Please check your inbox.</span></div>
            }

            <form asp-action="ForgetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="alert-c is-error" role="alert"></div>
                <div class="field">
                    <label for="email">Email address</label>
                    <input id="email" type="email" name="email" class="form-control" placeholder="james@example.com" autocomplete="email" required />
                </div>
                <button type="submit" class="btn-brand btn-block py-3">Send reset link</button>
            </form>

            <div class="auth-foot">Remember your password? <a asp-action="Login">Back to log in</a></div>
        </div>
    </div>
</div>
