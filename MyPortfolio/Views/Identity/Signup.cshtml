@model RegisterViewmodel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-wrap">
    <div class="container">
        <div class="auth-card">
            <h1>Create account</h1>
            <p class="auth-sub">Join the CHRONOS collector community</p>

            <form asp-action="Signup" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert-c is-error" role="alert"></div>

                <div class="row g-3">
                    <div class="col-sm-6 field mb-0">
                        <label asp-for="FirstName">First name</label>
                        <input asp-for="FirstName" class="form-control" placeholder="James" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-6 field mb-0">
                        <label asp-for="LastName">Last name</label>
                        <input asp-for="LastName" class="form-control" placeholder="Morley" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="field mt-3">
                    <label asp-for="Email">Email address</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="james@example.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="Password">Password</label>
                    <div class="input-icon">
                        <input asp-for="Password" class="form-control" placeholder="Minimum 8 characters" autocomplete="new-password" />
                        <button type="button" class="toggle-btn" data-toggle-password aria-label="Show password"><i class="fas fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <div class="input-icon">
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Repeat your password" autocomplete="new-password" />
                        <button type="button" class="toggle-btn" data-toggle-password aria-label="Show password"><i class="fas fa-eye"></i></button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn-brand btn-block py-3">Create my account</button>
            </form>

            <div class="auth-foot">Already a member? <a asp-action="Login">Log in here</a></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
