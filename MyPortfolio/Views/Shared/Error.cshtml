@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="section">
    <div class="container text-center" style="max-width:620px">
        <div class="confirm-icon"><i class="fas fa-triangle-exclamation"></i></div>
        <h1 class="mb-3">Something went wrong</h1>
        <p class="text-muted-c">We couldn't complete your request. Please try again, or head back to the homepage.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted-c" style="font-size:.85rem">Request ID: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a class="btn-brand" asp-controller="Home" asp-action="Index">Back to home</a>
            <a class="btn-quiet" asp-controller="Home" asp-action="Contact">Contact us</a>
        </div>
    </div>
</section>
