@{
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    Func<string[], string> active = names =>
        names.Any(n => string.Equals(n, action, StringComparison.OrdinalIgnoreCase)) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] — CHRONOS Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Marcellus&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="admin">
    <div class="admin-backdrop" id="adminBackdrop"></div>

    <aside class="admin-sidebar" id="adminSidebar" aria-label="Admin navigation">
        <div class="admin-brand">
            <div class="brand-mark">
                <span class="brand-name">CHRONOS</span>
                <span class="brand-tagline">Admin panel</span>
            </div>
        </div>
        <nav class="admin-nav">
            <div class="admin-nav-title">Overview</div>
            <a class="admin-nav-link @(active(new[] { "Adminashboard" }))" asp-controller="Home" asp-action="Adminashboard"><i class="fas fa-chart-pie"></i> Dashboard</a>
            <div class="admin-nav-title">Catalogue</div>
            <a class="admin-nav-link @(active(new[] { "Adminproduct", "Editproduct", "DeleteProduct" }))" asp-controller="Home" asp-action="Adminproduct"><i class="fas fa-box-open"></i> All products</a>
            <a class="admin-nav-link @(active(new[] { "AddProduct" }))" asp-controller="Home" asp-action="AddProduct"><i class="fas fa-circle-plus"></i> Add product</a>
            <div class="admin-nav-title">Customers</div>
            <a class="admin-nav-link @(active(new[] { "AdminOrder", "AdminOrderDetail" }))" asp-controller="Order" asp-action="AdminOrder"><i class="fas fa-receipt"></i> Orders</a>
            <a class="admin-nav-link @(active(new[] { "AdminContact" }))" asp-controller="Home" asp-action="AdminContact"><i class="fas fa-envelope"></i> Contact messages @await Component.InvokeAsync("UnreadMessages")</a>
            <div class="admin-nav-title">Site</div>
            <a class="admin-nav-link" asp-controller="Home" asp-action="Index"><i class="fas fa-arrow-left"></i> Back to site</a>
        </nav>
        <div class="admin-user">
            <span class="avatar"><i class="fas fa-user-shield"></i></span>
            <div>Admin<small>Store manager</small></div>
        </div>
    </aside>

    <div class="admin-mobilebar">
        <button type="button" class="icon-btn" data-admin-toggle aria-label="Open menu" aria-controls="adminSidebar"><i class="fas fa-bars"></i></button>
        <span class="brand-name">CHRONOS</span>
        <a class="icon-btn" asp-controller="Home" asp-action="Index" aria-label="Back to site"><i class="fas fa-house"></i></a>
    </div>

    <main class="admin-main">
        @if (TempData["AdminSuccess"] is string okMessage)
        {
            <div class="alert-c is-success" role="status"><i class="fas fa-circle-check mt-1"></i><span>@okMessage</span></div>
        }
        @if (TempData["AdminError"] is string errMessage)
        {
            <div class="alert-c is-error" role="alert"><i class="fas fa-circle-exclamation mt-1"></i><span>@errMessage</span></div>
        }
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
