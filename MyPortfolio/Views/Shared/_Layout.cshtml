@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    Func<string, string, string> active = (c, a) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(action, a, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — CHRONOS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Marcellus&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-nav">
        <nav class="navbar navbar-expand-lg" aria-label="Main navigation">
            <div class="container">
                <a class="brand-mark" asp-controller="Home" asp-action="Index" aria-label="CHRONOS home">
                    <span class="brand-name">CHRONOS</span>
                    <span class="brand-tagline">Maison Horlogère · Est. 1968</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fas fa-bars"></i>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <div class="navbar-nav ms-lg-auto">
                        <a class="nav-link-c @(active("Home", "Index"))" asp-controller="Home" asp-action="Index">Home</a>
                        <a class="nav-link-c @(active("Home", "Product"))" asp-controller="Home" asp-action="Product">Collection</a>
                        <a class="nav-link-c @(active("Home", "About"))" asp-controller="Home" asp-action="About">About</a>
                        <a class="nav-link-c @(active("Home", "Contact"))" asp-controller="Home" asp-action="Contact">Contact</a>
                    </div>
                    <div class="nav-actions">
                        @if (signedIn)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn-brand btn-sm-c" asp-controller="Home" asp-action="Adminashboard"><i class="fas fa-gauge"></i> Dashboard</a>
                            }
                            <a class="btn-quiet btn-sm-c" asp-controller="Order" asp-action="Myorder"><i class="fas fa-box"></i> My Orders</a>
                            <a class="btn-quiet btn-sm-c" asp-controller="Cart" asp-action="Cart"><i class="fas fa-cart-shopping"></i> Cart</a>
                            <form asp-controller="Identity" asp-action="Logout" method="post">
                                <button type="submit" class="btn-quiet btn-sm-c"><i class="fas fa-right-from-bracket"></i> Log out</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn-quiet btn-sm-c" asp-controller="Identity" asp-action="Login">Log in</a>
                            <a class="btn-brand btn-sm-c" asp-controller="Identity" asp-action="Signup">Sign up</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="main-wrap">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 g-lg-5">
                <div class="col-lg-5">
                    <div class="brand-mark">
                        <span class="brand-name">CHRONOS</span>
                        <span class="brand-tagline">Maison Horlogère · Est. 1968</span>
                    </div>
                    <p>We curate the world's finest timepieces for discerning collectors. Every watch in our collection is a work of art.</p>
                </div>
                <div class="col-6 col-lg-2 offset-lg-1">
                    <div class="footer-heading">Shop</div>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Product">Collection</a></li>
                        <li><a asp-controller="Cart" asp-action="Cart">Cart</a></li>
                        <li><a asp-controller="Order" asp-action="Myorder">My orders</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="footer-heading">Company</div>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="About">About CHRONOS</a></li>
                        <li><a asp-controller="Home" asp-action="Contact">Contact us</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy policy</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <div class="footer-heading">Account</div>
                    <ul class="footer-links">
                        @if (signedIn)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a asp-controller="Home" asp-action="Adminashboard">Admin dashboard</a></li>
                            }
                            <li><a asp-controller="Order" asp-action="Myorder">My orders</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Identity" asp-action="Login">Log in</a></li>
                            <li><a asp-controller="Identity" asp-action="Signup">Create account</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">© @DateTime.Now.Year CHRONOS Maison Horlogère. All rights reserved.</div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
